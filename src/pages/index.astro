---
import BaseHead from '../components/BaseHead.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { HRPAUTH, PROFILE, PROJECTS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main" class="shell">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-kicker">
					<p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Samuel Cheston / Independent developer</p>
					<span class="eyebrow hero-index">Build. Think. Connect.</span>
				</div>
				<h1 id="hero-title">I build the systems<br />behind <span class="accent-text">the play.</span></h1>
				<div class="hero-bottom">
					<p class="hero-description">
						I'm Samuel, the independent developer behind <strong>MatchCore</strong>.
						What started with ELO-MMR matchmaking for Minecraft is becoming an ecosystem
						of authentication, tools, and connected services.
					</p>
					<div class="hero-actions">
						<a class="button button-dark" href="#build">Explore my work <span aria-hidden="true">&darr;</span></a>
						<a class="text-link" href={PROFILE.github}>Find me on GitHub <span aria-hidden="true">&nearr;</span></a>
					</div>
				</div>
			</section>

			<section id="build" class="build-section" aria-labelledby="build-title">
				<div class="section-heading">
					<p class="eyebrow"><span class="section-number">01 /</span> Build</p>
					<p class="section-aside">From an idea to something people use.</p>
				</div>
				<div class="featured-project">
					<div class="featured-copy">
						<div class="feature-label"><span class="eyebrow">Featured ecosystem</span><span class="badge">Independently built</span></div>
						<h2 id="build-title">MatchCore<span class="accent-text">.</span></h2>
						<p class="feature-lead">A matchmaking idea.<br />An entire ecosystem to build.</p>
						<p>
							I wanted to bring ELO-MMR matchmaking to Minecraft. That goal became
							the starting point for MatchCore, the ecosystem I'm building from the ground up.
						</p>
						<p>
							HRPAuth is one part of that work: my own approach to Minecraft
							authentication and skin management, already used by {HRPAUTH.users} real people.
						</p>
						<div class="feature-stats">
							<div><strong>{HRPAUTH.users}</strong><span>real HRPAuth users</span></div>
							<div><strong class="stat-text">Actively evolving</strong><span>HRPAuth / rapid iteration</span></div>
						</div>
						<a class="button button-dark" href={PROFILE.ecosystem}>Explore MatchCore <span aria-hidden="true">&nearr;</span></a>
					</div>
					<EcosystemMap />
				</div>
			</section>

			<section class="selected-section" aria-labelledby="selected-title">
				<div class="section-heading selected-heading">
					<h2 id="selected-title">Selected work</h2>
					<span class="eyebrow">Three different sides of how I build</span>
				</div>
				<div class="project-grid">
					{PROJECTS.map((project) => (
						<article class="project-card">
							<div class="project-card-top"><span class="project-number">{project.number}</span><span class="eyebrow">{project.category}</span></div>
							<h3><a href={project.url}>{project.name}<span aria-hidden="true">&nearr;</span></a></h3>
							<p>{project.description}</p>
							<p class="project-detail">{project.detail}</p>
							<ul class="tags" aria-label={`${project.name} technologies`}>
								{project.technologies.map((technology) => <li>{technology}</li>)}
							</ul>
							<a class="project-source text-link" href={project.url}>View source <span class="sr-only">for {project.name}</span><span aria-hidden="true">&nearr;</span></a>
						</article>
					))}
				</div>
			</section>

			<section id="think" class="thinking-section" aria-labelledby="think-title">
				<div class="section-heading">
					<p class="eyebrow"><span class="section-number">02 /</span> Think</p>
					<p class="section-aside">The decisions behind the code.</p>
				</div>
				<div class="thinking-grid">
					<div>
						<p class="eyebrow accent-text">A decision behind HRPAuth</p>
						<h2 id="think-title">Sometimes, the next step<br />is a new foundation.</h2>
					</div>
					<div class="thinking-copy">
						<p>
							Blessing Skin already offered a mature solution. But for the direction I wanted
							to take MatchCore, I felt its technology choices put a ceiling on what I could build.
						</p>
						<p>
							Rather than keep adapting that foundation, I chose to build HRPAuth myself.
							Not just to replace an authentication service, but to shape it around the
							larger ecosystem I wanted to create.
						</p>
						<a class="text-link" href="/about">More about my work <span aria-hidden="true">&rarr;</span></a>
					</div>
				</div>
			</section>

			<aside class="now-strip" aria-labelledby="now-title">
				<div class="now-label"><span class="status-dot" aria-hidden="true"></span><h2 id="now-title" class="eyebrow">Currently building</h2></div>
				<p>Still deep in MatchCore. Iterating on HRPAuth and the projects around it.</p>
				<a class="text-link" href={HRPAUTH.url}>Follow the code <span aria-hidden="true">&nearr;</span></a>
			</aside>

			<section id="connect" class="connect-section" aria-labelledby="connect-title">
				<p class="eyebrow"><span class="section-number">03 /</span> Connect</p>
				<div class="connect-grid">
					<div>
						<h2 id="connect-title">Good conversations<br />start with <span class="accent-text">something real.</span></h2>
						<p>Matchmaking, game infrastructure, or a different way to build it.<br class="desktop-break" /> Find me where the work happens.</p>
					</div>
					<div class="contact-links">
						<a href={PROFILE.github}><span><small>Find me on GitHub</small>SamuelCheston</span><span aria-hidden="true">&nearr;</span></a>
						<a href={PROFILE.ecosystem}><span><small>Explore the ecosystem</small>MatchCore</span><span aria-hidden="true">&nearr;</span></a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
