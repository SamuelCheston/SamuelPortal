---
import { PROFILE } from '../consts';

const pathname = Astro.url.pathname.replace(/\/$/, '');
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/" aria-label={`${PROFILE.name}, home`}>
                        <span class="brand-mark" aria-hidden="true">s<span>.</span></span>
                        <span>samuel<span class="brand-period">.</span></span>
		</a>
		<nav aria-label="Main navigation">
                        <a href="/projects" aria-current={pathname === '/projects' ? 'page' : undefined}>Projects</a>
                        <a href="/about" aria-current={pathname === '/about' ? 'page' : undefined}>About</a>
                        <a class="nav-contact" href={PROFILE.github}>
                                GitHub <span aria-hidden="true">↗</span>
			</a>
		</nav>
	</div>
</header>
