---
import { PROFILE } from '../consts';

const isAbout = Astro.url.pathname.replace(/\/$/, '') === '/about';
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/" aria-label={`${PROFILE.name}, home`}>
			<span class="brand-mark" aria-hidden="true">sc<span>.</span></span>
			<span>Samuel Cheston</span>
		</a>
		<nav aria-label="Main navigation">
			<a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a>
                        <a class="nav-contact" href={PROFILE.github}>
                                GitHub <span aria-hidden="true">&nearr;</span>
			</a>
		</nav>
	</div>
</header>
